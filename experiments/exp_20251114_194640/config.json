{
  "experiment": {
    "name": "baseline_tavily_7d",
    "description": "Baseline experiment with 7-day time range for Tavily search",
    "tags": [
      "baseline",
      "tavily"
    ]
  },
  "input_data": {
    "ticker": "ASML"
  },
  "tools": {
    "tavily": {
      "max_results": 5,
      "include_answer": true,
      "include_raw_content": false,
      "include_images": false,
      "search_depth": "advanced",
      "time_range": "7d"
    },
    "alphavantage": {
      "function": "INCOME_STATEMENT"
    },
    "openai": {
      "enabled": true,
      "model": "gpt-4o-mini",
      "temperature": 0.3
    }
  },
  "financials_schema": {
    "fields": [
      {
        "name": "revenue",
        "type": "float",
        "description": "Company revenue",
        "required": true
      },
      {
        "name": "assets",
        "type": "float",
        "description": "Total assets",
        "required": true
      },
      {
        "name": "equity",
        "type": "float",
        "description": "Shareholders' equity",
        "required": true
      },
      {
        "name": "debt",
        "type": "float",
        "description": "Total debt",
        "required": true
      },
      {
        "name": "cash",
        "type": "float",
        "description": "Cash and cash equivalents",
        "required": true
      },
      {
        "name": "interest_coverage_ratio",
        "type": "float",
        "description": "Interest coverage ratio (EBIT / interest expense)",
        "required": true
      }
    ],
    "default_values": {
      "revenue": 5000000,
      "assets": 10000000,
      "equity": 5000000,
      "debt": 5000000,
      "cash": 1000000,
      "interest_coverage_ratio": 10
    }
  },
  "graph": {
    "nodes": [
      {
        "name": "sanitize_input",
        "enabled": true
      },
      {
        "name": "due_diligence",
        "enabled": true
      },
      {
        "name": "industry",
        "enabled": true
      },
      {
        "name": "credit_risk",
        "enabled": true
      },
      {
        "name": "credit_officer",
        "enabled": true
      }
    ],
    "edges": [
      {
        "from": "sanitize_input",
        "to": [
          "due_diligence",
          "credit_risk"
        ]
      },
      {
        "from": "due_diligence",
        "to": "industry"
      },
      {
        "from": "credit_risk",
        "to": "industry"
      },
      {
        "from": "industry",
        "to": "credit_officer"
      }
    ]
  },
  "decision_rules": {
    "altman_z_threshold": 2.6,
    "require_no_major_risks": true
  }
}